<Application x:Class="MAXOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ── Premium Futuristic AI HUD Color Palette ──────────────────────── -->
        
        <!-- Primary Cyan / Sky Blue Energy -->
        <Color x:Key="ColorCyanCore">#00F0FF</Color>
        <Color x:Key="ColorSkyBlue">#38BDF8</Color>
        <Color x:Key="ColorSkyBlueGlow">#7DD3FC</Color>
        <Color x:Key="ColorSkyBlueDark">#0369A1</Color>
        <Color x:Key="ColorSkyBlueDeep">#082F49</Color>

        <!-- Secondary Violet / Purple Accents -->
        <Color x:Key="ColorVioletCore">#8B5CF6</Color>
        <Color x:Key="ColorVioletGlow">#C084FC</Color>
        <Color x:Key="ColorVioletDark">#5B21B6</Color>
        <Color x:Key="ColorPurpleDeep">#3B0764</Color>

        <!-- Semantic Colors -->
        <Color x:Key="ColorEmeraldSuccess">#10B981</Color>
        <Color x:Key="ColorEmeraldGlow">#34D399</Color>
        <Color x:Key="ColorAmberWarning">#F59E0B</Color>
        <Color x:Key="ColorAmberGlow">#FCD34D</Color>
        <Color x:Key="ColorCrimsonError">#EF4444</Color>
        <Color x:Key="ColorCrimsonGlow">#F87171</Color>

        <!-- Glass Chassis & Backgrounds -->
        <Color x:Key="ColorDarkGlass">#CC090D16</Color>
        <Color x:Key="ColorDarkGlassDeep">#EE060810</Color>
        <Color x:Key="ColorDarkGlassHighlight">#221E293B</Color>
        <Color x:Key="ColorBorderSubtle">#3338BDF8</Color>
        <Color x:Key="ColorBorderBright">#8838BDF8</Color>

        <!-- Text Colors -->
        <Color x:Key="ColorTextPrimary">#F1F5F9</Color>
        <Color x:Key="ColorTextSecondary">#94A3B8</Color>
        <Color x:Key="ColorTextMuted">#64748B</Color>

        <!-- ── Solid Brushes ────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="CyanCoreBrush" Color="{StaticResource ColorCyanCore}"/>
        <SolidColorBrush x:Key="SkyBlueBrush" Color="{StaticResource ColorSkyBlue}"/>
        <SolidColorBrush x:Key="SkyBlueGlowBrush" Color="{StaticResource ColorSkyBlueGlow}"/>
        <SolidColorBrush x:Key="SkyBlueDarkBrush" Color="{StaticResource ColorSkyBlueDark}"/>
        <SolidColorBrush x:Key="VioletCoreBrush" Color="{StaticResource ColorVioletCore}"/>
        <SolidColorBrush x:Key="VioletGlowBrush" Color="{StaticResource ColorVioletGlow}"/>
        <SolidColorBrush x:Key="EmeraldSuccessBrush" Color="{StaticResource ColorEmeraldSuccess}"/>
        <SolidColorBrush x:Key="EmeraldGlowBrush" Color="{StaticResource ColorEmeraldGlow}"/>
        <SolidColorBrush x:Key="AmberWarningBrush" Color="{StaticResource ColorAmberWarning}"/>
        <SolidColorBrush x:Key="AmberGlowBrush" Color="{StaticResource ColorAmberGlow}"/>
        <SolidColorBrush x:Key="CrimsonErrorBrush" Color="{StaticResource ColorCrimsonError}"/>
        <SolidColorBrush x:Key="CrimsonGlowBrush" Color="{StaticResource ColorCrimsonGlow}"/>
        
        <SolidColorBrush x:Key="DarkGlassBrush" Color="{StaticResource ColorDarkGlass}"/>
        <SolidColorBrush x:Key="DarkGlassDeepBrush" Color="{StaticResource ColorDarkGlassDeep}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>

        <!-- ── Linear / Radial Gradient Brushes ─────────────────────────────── -->
        <LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E60A0E1A" Offset="0"/>
            <GradientStop Color="#D90D1322" Offset="0.5"/>
            <GradientStop Color="#F0060913" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8038BDF8" Offset="0"/>
            <GradientStop Color="#258B5CF6" Offset="0.5"/>
            <GradientStop Color="#6000F0FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThinkingBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#908B5CF6" Offset="0"/>
            <GradientStop Color="#30C084FC" Offset="0.5"/>
            <GradientStop Color="#8038BDF8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AmberBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF59E0B" Offset="0"/>
            <GradientStop Color="#40F59E0B" Offset="0.5"/>
            <GradientStop Color="#AAFBBF24" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CyanReactorBrush">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#00F0FF" Offset="0.25"/>
            <GradientStop Color="#38BDF8" Offset="0.6"/>
            <GradientStop Color="#0369A1" Offset="0.9"/>
            <GradientStop Color="#000284C7" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="VioletReactorBrush">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#C084FC" Offset="0.25"/>
            <GradientStop Color="#8B5CF6" Offset="0.6"/>
            <GradientStop Color="#5B21B6" Offset="0.9"/>
            <GradientStop Color="#004C1D95" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="AmberReactorBrush">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FCD34D" Offset="0.25"/>
            <GradientStop Color="#F59E0B" Offset="0.6"/>
            <GradientStop Color="#B45309" Offset="0.9"/>
            <GradientStop Color="#0078350F" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="EmeraldReactorBrush">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#34D399" Offset="0.25"/>
            <GradientStop Color="#10B981" Offset="0.6"/>
            <GradientStop Color="#047857" Offset="0.9"/>
            <GradientStop Color="#00064E3B" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="CrimsonReactorBrush">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F87171" Offset="0.25"/>
            <GradientStop Color="#EF4444" Offset="0.6"/>
            <GradientStop Color="#B91C1C" Offset="0.9"/>
            <GradientStop Color="#007F1D1D" Offset="1"/>
        </RadialGradientBrush>

        <!-- ── Glass Button Styles ─────────────────────────────────────────── -->
        <Style x:Key="GlassApproveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2210B981"/>
            <Setter Property="Foreground" Value="#34D399"/>
            <Setter Property="BorderBrush" Value="#6610B981"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4410B981"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#AA34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#6610B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassRejectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22EF4444"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#44EF4444"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#AAF87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#66EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Futuristic Segmented HUD Progress Bar -->
        <Style x:Key="HudProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#2238BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Track" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00F0FF" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
