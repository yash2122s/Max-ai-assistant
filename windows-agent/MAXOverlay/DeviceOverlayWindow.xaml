<Window x:Class="MAXOverlay.DeviceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MAXOverlay.Controls"
        Title="MAX Device FX"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <!-- Fullscreen click-through overlay with GPU-composited perimeter HUD -->
    <Grid x:Name="RootContainer">
        <controls:DevicePerimeterVisual x:Name="PerimeterVisual"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
    </Grid>
</Window>
