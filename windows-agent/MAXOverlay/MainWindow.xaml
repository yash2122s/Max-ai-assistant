<Window x:Class="MAXOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MAXOverlay.Controls"
        Title="MAX Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="220" Height="42"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Top">
        <!-- Dynamic Island Outer Glass Capsule -->
        <Border x:Name="IslandBorder"
                CornerRadius="21"
                Background="{StaticResource GlassBackgroundBrush}"
                BorderThickness="1.2"
                BorderBrush="{StaticResource GlassBorderBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MinWidth="200" MinHeight="40"
                Padding="12,6"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect x:Name="IslandGlow" Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <!-- Background Particle Canvas (GPU DrawingContext) -->
                <controls:ParticleCanvas x:Name="HudParticles" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Perimeter Light Sweep (Active during speaking / transitions) -->
                <Border x:Name="PerimeterSweepBorder"
                        CornerRadius="20"
                        BorderThickness="1.5"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush x:Name="SweepGradient" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="SweepStop0" Color="#0000F0FF" Offset="0"/>
                            <GradientStop x:Name="SweepStop1" Color="#FF00F0FF" Offset="0.5"/>
                            <GradientStop x:Name="SweepStop2" Color="#008B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- IDLE / COMPACT VIEW (220 x 42)                                 -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="CompactView" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Concentric Reactor Core Assembly -->
                        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <!-- Outer Breathing Ring -->
                            <Ellipse x:Name="IdleReactorHalo" Width="18" Height="18"
                                     Stroke="#5538BDF8" StrokeThickness="1"
                                     RenderTransformOrigin="0.5,0.5"/>
                            <!-- Inner Glowing Core -->
                            <Ellipse x:Name="IdleReactorCore" Width="10" Height="10"
                                     Fill="{StaticResource CyanReactorBrush}"
                                     RenderTransformOrigin="0.5,0.5"/>
                        </Grid>

                        <TextBlock x:Name="CompactStatusText" Text="MAX"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#38BDF8" BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Subtle Connection Indicator Dot -->
                        <Ellipse x:Name="CompactConnDot" Width="5" Height="5"
                                 Fill="{StaticResource CyanCoreBrush}"
                                 Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- EXPANDED HUD VIEW (~480 x 110)                                 -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header / Status Badge -->
                        <RowDefinition Height="*"/>
                        <!-- Waveform / Task / Confirmation -->
                        <RowDefinition Height="Auto"/>
                        <!-- Transcript / Subtitle -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Reactor Core + State Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Expanded Reactor Core with Orbital Rings -->
                        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                            <!-- Orbital Ring 1 (Rotates in Thinking state) -->
                            <Ellipse x:Name="ExpandedOrbitalRing1" Width="22" Height="22"
                                     Stroke="#6638BDF8" StrokeThickness="1.2"
                                     StrokeDashArray="3 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OrbitRotate1" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Orbital Ring 2 -->
                            <Ellipse x:Name="ExpandedOrbitalRing2" Width="18" Height="18"
                                     Stroke="#558B5CF6" StrokeThickness="1"
                                     StrokeDashArray="2 3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="OrbitRotate2" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Center Core -->
                            <Ellipse x:Name="ExpandedReactorCore" Width="11" Height="11"
                                     Fill="{StaticResource CyanReactorBrush}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00F0FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>

                        <!-- HUD Status Badge -->
                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#1A38BDF8" CornerRadius="8" Padding="8,2"
                                BorderBrush="#3338BDF8" BorderThickness="0.8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ExpandedStatusDot" Width="6" Height="6"
                                         Fill="{StaticResource CyanCoreBrush}"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpandedStatusLabel" Text="LISTENING"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource SkyBlueGlowBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Secondary State Hint / Step / Tool -->
                        <TextBlock x:Name="ExpandedSubStateText" Grid.Column="2"
                                   Text=""
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Normal"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 1: Content Area (Waveform, Task Progress, or Confirmation) -->
                    <Grid Grid.Row="1" MinHeight="36" VerticalAlignment="Center">

                        <!-- Mode A: Audio Waveform (Listening / Speaking) -->
                        <controls:WaveformVisual x:Name="AudioWaveform"
                                                 Height="34" HorizontalAlignment="Stretch"
                                                 Visibility="Visible"/>

                        <!-- Mode B: Thinking Orbit Animation -->
                        <Grid x:Name="ThinkingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Processing request..."
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource VioletGlowBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode C: Task Execution Panel -->
                        <Grid x:Name="TaskPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,2,0,4">
                                <TextBlock x:Name="TaskTitleText" Text="Task Execution"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SkyBlueGlowBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TaskProgressPct" Text="0%"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource VioletGlowBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="TaskProgressBar" Grid.Row="1"
                                         Style="{StaticResource HudProgressBarStyle}"
                                         Minimum="0" Maximum="100" Value="0"
                                         HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Mode D: Confirmation Panel -->
                        <Border x:Name="ConfirmationPanel" Visibility="Collapsed"
                                Background="#D0151109" CornerRadius="10" Padding="10,6"
                                BorderBrush="{StaticResource AmberBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header & Timer -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock x:Name="ConfirmActionText" Text="⚠️ Confirmation Required"
                                               FontFamily="Segoe UI Variable, Segoe UI"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource AmberGlowBrush}"
                                               HorizontalAlignment="Left"/>
                                    <ProgressBar x:Name="ConfirmExpiryProgress"
                                                 Width="60" Height="3"
                                                 Minimum="0" Maximum="100" Value="100"
                                                 Background="#22F59E0B" Foreground="{StaticResource AmberWarningBrush}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Description -->
                                <TextBlock x:Name="ConfirmDescText" Grid.Row="1"
                                           Text="Are you sure you want to proceed?"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,6"/>

                                <!-- Approve & Reject Glass Buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ApproveButton" Content="Approve"
                                            Style="{StaticResource GlassApproveButtonStyle}"
                                            Click="OnApproveClick"
                                            Margin="0,0,8,0"/>
                                    <Button x:Name="RejectButton" Content="Reject"
                                            Style="{StaticResource GlassRejectButtonStyle}"
                                            Click="OnRejectClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: Live Transcript / Speech Subtitles -->
                    <TextBlock x:Name="TranscriptText" Grid.Row="2"
                               Text=""
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="450"
                               Margin="0,3,0,0"/>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════ -->
                <!-- TRANSIENT PULSE HUD OVERLAY (Success / Error / Wake Pulse)     -->
                <!-- ══════════════════════════════════════════════════════════════ -->
                <Border x:Name="TransientPulseOverlay"
                        CornerRadius="21"
                        Background="#0010B981"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TransientIconText" Text="✓"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource EmeraldGlowBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
