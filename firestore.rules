rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // License timestamps are Firestore timestamps. A trial lasts at most seven
    // server-relative days; lifetime activation references a 64-char key hash.
    function validLicenseIdentity(data, userId) {
      return data.userId == userId
        && data.plan is string && data.status is string
        && data.updatedAt == request.time;
    }

    function validInitialTrial(data) {
      return data.trialStartedAt == request.time
        && data.issuedAt == request.time
        && data.trialExpiresAt is timestamp
        && data.trialExpiresAt > request.time
        && data.trialExpiresAt <= request.time + duration.value(7, 'd')
        && data.expiresAt == data.trialExpiresAt;
    }

    function ownsClaimedLifetimeKey(data, userId) {
      return data.licenseId is string
        && data.licenseId.matches('^[a-f0-9]{64}$')
        && getAfter(/databases/$(database)/documents/licenseKeys/$(data.licenseId)).data.status == 'CLAIMED'
        && getAfter(/databases/$(database)/documents/licenseKeys/$(data.licenseId)).data.claimedBy == userId
        && getAfter(/databases/$(database)/documents/licenseKeys/$(data.licenseId)).data.type == 'LIFETIME'
        && data.expiresAt == null;
    }

    // 1. Users collection:
    // Each user can read and update their own user profile document.
    // They cannot delete user profiles or access other users' profiles.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if false;

      // Devices subcollection:
      // Track active registered devices per user.
      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.deviceId == deviceId;
        allow delete: if isOwner(userId);
      }

      // Cloud memory is opt-in at the client, but always owner-scoped here.
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.memoryId == memoryId
          && request.resource.data.revision is int
          && request.resource.data.revision >= 0
          && request.resource.data.deleted is bool
          && request.resource.data.keys().hasOnly(['memoryId','revision','deleted','title','content','category','tags','enabled','pinned','createdAt','updatedAt','contentHash'])
          && (request.resource.data.deleted == true ||
              (request.resource.data.title is string && request.resource.data.title.size() <= 200
               && request.resource.data.content is string && request.resource.data.content.size() <= 20000
               && request.resource.data.category is string && request.resource.data.category.size() <= 100
               && request.resource.data.tags is string && request.resource.data.tags.size() <= 2000
               && request.resource.data.enabled is bool && request.resource.data.pinned is bool
               && request.resource.data.createdAt is int && request.resource.data.updatedAt is int
               && request.resource.data.contentHash is string));
        allow delete: if false;
      }
    }

    // 2. Licenses collection:
    // Authoritative cloud license for each user.
    // - Client can read their own license.
    // - A newly authenticated user can only CREATE an initial TRIAL license if one does NOT exist.
    // - Client cannot arbitrarily forge LIFETIME or extend TRIAL dates.
    // - Upgrading to LIFETIME requires a valid, claimed key in licenseKeys/{keyHash}.
    // - Client CANNOT delete their license to reset their trial counter.
    match /licenses/{userId} {
      allow read: if isOwner(userId);

      // Initial trial creation or direct LIFETIME activation
      allow create: if isOwner(userId)
        && validLicenseIdentity(request.resource.data, userId)
        && (
          (
            request.resource.data.plan == 'TRIAL'
            && request.resource.data.status == 'TRIAL'
            && validInitialTrial(request.resource.data)
            && (!('licenseId' in request.resource.data) || request.resource.data.licenseId == null)
          ) || (
            request.resource.data.plan == 'LIFETIME'
            && request.resource.data.status == 'ACTIVE'
            && ownsClaimedLifetimeKey(request.resource.data, userId)
          )
        );

      // Upgrading to LIFETIME or non-privilege metadata update
      allow update: if isOwner(userId)
        && validLicenseIdentity(request.resource.data, userId)
        && resource.data.status != 'REVOKED'
        && (
          // Case A: Upgrading to LIFETIME via claimed/claiming license key
          (
            request.resource.data.plan == 'LIFETIME'
            && request.resource.data.status == 'ACTIVE'
            && ownsClaimedLifetimeKey(request.resource.data, userId)
          )
          // Case B: Safe metadata update (cannot modify plan, status, or trial dates)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          )
        );

      allow delete: if false;

      // Daily usage subcollection:
      // Track AI message consumption per 24h period.
      // - Max 100 messages for trial users.
      // - Client cannot decrease counter or reset early.
      match /dailyUsage/{period} {
        allow read: if isOwner(userId);

        // Can create today's usage doc starting at 1 on first message
        allow create: if isOwner(userId)
          && request.resource.data.period == period
          && request.resource.data.messageCount == 1;

        // Can only increment messageCount
        allow update: if isOwner(userId)
          && request.resource.data.period == resource.data.period
          && request.resource.data.messageCount == resource.data.messageCount + 1;

        allow delete: if false;
      }
    }

    // 3. License Keys collection:
    // licenseKeys/{keyHash}
    // High-entropy hashed keys generated only by owner/admin.
    match /licenseKeys/{keyHash} {
      // Disallow collection queries/listing to prevent enumeration of keys
      allow list: if false;
      // Allow reading a specific key if user knows its hash (for activation transaction)
      allow get: if isAuthenticated();

      // Only allow transitioning an UNUSED key to CLAIMED by the current user
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
        && resource.data.status == 'UNUSED'
        && request.resource.data.status == 'CLAIMED'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && request.resource.data.type == resource.data.type;

      // Normal clients cannot create or delete keys
      allow create, delete: if false;
    }

    // 4. Analytics & Activity Tracking Collections:
    // Only administrators with custom claim admin == true can list/read all activity events.
    // Authenticated users can write their own activity events with trusted timestamp.
    match /activityEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId == eventId
        && request.resource.data.serverTimestamp == request.time;
      allow update, delete: if false;
    }

    // User session tracking
    match /userSessions/{sessionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.startedAt == request.time;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat', 'lastHeartbeatAt', 'isActive', 'endedAt', 'durationMs']);
      allow delete: if false;
    }

    // Aggregates are written by the authenticated ingestion function via the Admin SDK.
    match /dailyAnalytics/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Global admin overview aggregates (only accessible by admins)
    match /adminAggregates/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // User analytics summary profiles (accessible by owner or admin)
    match /userAnalytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Catch-all: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
