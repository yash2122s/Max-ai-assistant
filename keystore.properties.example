# MAX Production Release Signing Properties Template
# Copy this file to keystore.properties or set environment variables in CI/CD.
# Required environment variables / properties:
#   RELEASE_STORE_FILE / KEYSTORE_PATH
#   RELEASE_STORE_PASSWORD / STORE_PASSWORD
#   RELEASE_KEY_ALIAS / KEY_ALIAS
#   RELEASE_KEY_PASSWORD / KEY_PASSWORD

RELEASE_STORE_FILE=../max-release-key.jks
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=max-release-key
RELEASE_KEY_PASSWORD=your_key_password
